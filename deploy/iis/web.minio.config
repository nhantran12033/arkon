<?xml version="1.0" encoding="utf-8"?>
<!--
  Arkon — IIS reverse proxy cho MinIO (site phụ "Arkon-Files")
  ============================================================
  Đổi tên thành web.config và đặt vào C:\inetpub\arkon-files\web.config
  Script deploy\win\configure-iis.ps1 tự copy vào đó.

  Vì sao cần site này:
    Link tải file / ảnh wiki là "presigned URL" do MinIO ký. Chữ ký SigV4 bao gồm
    header Host (kể cả port), nên hostname:port trong URL phải đúng bằng thứ mà
    MinIO nhận được.
      -> BẮT BUỘC bật "Preserve original HOST header" trong ARR.
      -> Trong .env đặt:  MINIO_PUBLIC_ENDPOINT=192.168.200.52:44381
         (khác rỗng => Arkon tự ký URL dạng https://)

  Portal chạy HTTPS thì site này BẮT BUỘC cũng phải HTTPS, nếu không trình duyệt
  chặn ảnh/file vì mixed content.
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />

    <security>
      <!-- Tên object trong MinIO có thể chứa ký tự đã encode (%2F, dấu +).
           Mặc định IIS chặn, phải cho phép double escaping. -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <rule name="Proxy to MinIO" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:9002/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
