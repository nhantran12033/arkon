<?xml version="1.0" encoding="utf-8"?>
<!--
  Arkon — IIS reverse proxy cho MinIO (site phụ, vd: files.congty.com)
  ====================================================================
  Đổi tên thành web.config và đặt vào physical path của site MinIO
  (vd: D:\inetpub\arkon-files\web.config).

  Vì sao cần site này:
    Link tải file / ảnh wiki là "presigned URL" do MinIO ký. Chữ ký SigV4 bao gồm
    header Host, nên hostname trong URL phải đúng bằng hostname mà MinIO nhận được.
    -> BẮT BUỘC bật "Preserve original HOST header" trong ARR (mặc định đã bật).
    -> Trong .env đặt:  MINIO_PUBLIC_ENDPOINT=files.congty.com
       (khi biến này khác rỗng, Arkon tự ký URL dạng https://)

  Nếu hệ thống chỉ chạy HTTP nội bộ và bạn chấp nhận mở port MinIO trực tiếp,
  có thể bỏ site này, để MINIO_PUBLIC_ENDPOINT rỗng và đặt
  MINIO_ENDPOINT=<ten-may-chu>:9002 — nhưng khi portal chạy HTTPS thì trình duyệt
  sẽ chặn (mixed content).
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />

    <security>
      <!-- Tên object trong MinIO có thể chứa ký tự đã encode (%2F, dấu +).
           Mặc định IIS chặn, phải cho phép double escaping. -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <rule name="Proxy to MinIO" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:9002/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
