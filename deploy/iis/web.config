<?xml version="1.0" encoding="utf-8"?>
<!--
  Arkon — IIS reverse proxy config
  =================================
  Đặt file này vào physical path của site IIS (vd: D:\inetpub\arkon\web.config).

  Yêu cầu module đã cài trên IIS:
    - URL Rewrite 2.1
    - Application Request Routing (ARR) 3.0  + đã bật "Enable proxy"

  Yêu cầu cho phép ghi đè server variable (chạy 1 lần, PowerShell admin):
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_HOST']" /commit:apphost

  Sơ đồ định tuyến:
    /api/*, /mcp*, /oauth/*, /.well-known/*, /docs, /redoc, /openapi.json, /health
        -> FastAPI  http://127.0.0.1:5055
    còn lại (kể cả /_next/*, /wiki/*, /login)
        -> Next.js  http://127.0.0.1:3000
-->
<configuration>
  <system.webServer>

    <!-- Trả nguyên response body của backend, không để IIS thay bằng trang lỗi của nó -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Upload tài liệu: 500 MB. Chỉnh theo nhu cầu. -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>

        <!-- 1) Ép HTTPS. Xoá rule này nếu site chỉ chạy HTTP nội bộ. -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) Báo cho backend biết request gốc là HTTPS. Uvicorn chạy với cờ
             proxy-headers sẽ đọc header này để sinh đúng base_url https://
             cho MCP OAuth discovery. -->
        <rule name="Set forwarded headers" stopProcessing="false">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="None" />
        </rule>

        <!-- 3) Các đường dẫn thuộc FastAPI -> port 5055 -->
        <rule name="Proxy to FastAPI" stopProcessing="true">
          <match url="^(api/.*|mcp|mcp/.*|oauth/.*|\.well-known/.*|docs|docs/.*|redoc|openapi\.json|health)$" />
          <action type="Rewrite" url="http://127.0.0.1:5055/{R:0}" logRewrittenUrl="true" />
        </rule>

        <!-- 4) Mọi thứ còn lại -> Next.js port 3000 -->
        <rule name="Proxy to Next.js" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" logRewrittenUrl="true" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
